<odoo>

    <!-- Vista de lista de proveedores -->
    <record id="view_proveedor_list" model="ir.ui.view">
        <field name="name">hueveria.proveedor.list</field>
        <field name="model">hueveria.proveedor</field>
        <field name="arch" type="xml">
            <list string="Lista de proveedores">
                <field name="nombreProveedor"/>
                <field name="tlfProveedor"/>
                <field name="correoProveedor"/>
                <field name="tipoProveedor"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario de proveedores -->
    <record id="view_proveedor_form" model="ir.ui.view">
        <field name="name">hueveria.proveedor.form</field>
        <field name="model">hueveria.proveedor</field>
        <field name="arch" type="xml">
            <form string="Ficha del proveedor">
                <sheet>

                    <group>
                        <group string="Información general">
                            <field name="nombreProveedor"/>
                            <field name="tipoProveedor"/>
                            <field name="imagen_EmpresaProveedor"
                                   widget="image"
                                   options="{'size': [150, 150]}"/>
                        </group>

                        <group string="Datos de contacto">
                            <field name="tlfProveedor"/>
                            <field name="correoProveedor"/>
                            <field name="direccionProveedor"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Productos suministrados">
                            <field name="productos_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para abrir los proveedores -->
    <record id="action_proveedor" model="ir.actions.act_window">
        <field name="name">Proveedores</field>
        <field name="res_model">hueveria.proveedor</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_proveedor_list"/>
    </record>

    <!-- Submenú de proveedores dentro de Avícola del Ebro -->
    <menuitem id="menu_proveedor"
              name="Proveedores"
              parent="menu_hueveria_root"
              action="action_proveedor"
              sequence="20"/>

</odoo>